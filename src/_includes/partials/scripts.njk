  <!-- Config del sitio para el JS del cliente: el MISMO site.json que usan los
       templates. Así el número de WhatsApp tampoco se hardcodea en el JS. -->
  <script id="site-config" type="application/json">{{ site | dump | safe }}</script>

  <!-- JS al final del body: el DOM ya está listo cuando el JS lo intenta acceder.
       nav.js trae el chrome compartido y define window.SITE; flip-cards.js trae
       la interacción de las tarjetas (no-op en páginas sin tarjetas); después va
       el script propio de cada página (`pageScript` en su front matter), si tiene. -->
  <script src="js/nav.js"></script>
  <script src="js/flip-cards.js"></script>
  {% if pageScript %}<script src="{{ pageScript }}"></script>{% endif %}
  <script src="https://unpkg.com/lucide@latest"></script>
  <script>lucide.createIcons();</script>