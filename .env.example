# Config de entorno — copia este archivo a `.env` y rellena los valores reales.
# `.env` NO se commitea (está en .gitignore); este `.env.example` sí, como referencia.
#
# El build de Eleventy lee estos valores (ver leerEnv() en .eleventy.js); las
# variables de entorno del proceso (CI, hosting) tienen prioridad sobre el .env.

# ID de medición de Google Analytics 4 (formato: G-XXXXXXXXXX).
# Déjalo vacío para no cargar analytics en desarrollo.
GA4_ID=

# URL del Web App de Google Apps Script que recibe el formulario de contacto.
# Ver SETUP_FORMULARIO.md para cómo desplegarlo y obtener esta URL.
# Si está vacía, el formulario solo guarda en localStorage y no intenta enviar nada.
APPS_SCRIPT_URL=
